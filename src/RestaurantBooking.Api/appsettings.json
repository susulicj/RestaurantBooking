{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  
  "Jwt": {
    "Issuer": "RestaurantBooking",
    "Audience": "RestaurantBookingClients",
    "ExpiryMinutes": 60
  },
  "Booking": {
    "TimeZoneId": "Europe/Belgrade",
    "DurationMinutes": 90,
    "SlotIntervalMinutes": 30,
    "MaxDaysAhead": 60
  },

  "AllowedHosts": "*"
}
